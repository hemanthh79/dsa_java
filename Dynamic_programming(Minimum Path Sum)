class Solution {
    public int minPathSum(int[][] grid) {
        int[][] dp = new int[grid.length][grid[0].length];
        for(int[] row :dp)
            Arrays.fill(row, -1);
        return helper(grid, dp, 0, 0);
    }

    public int helper(int[][] grid, int[][] dp, int i, int j) {

        if(i == grid.length-1 && j == grid[0].length-1) {
            dp[i][j] = grid[i][j];
            return dp[i][j];
        }

        if(dp[i][j] != -1) return dp[i][j];

        if(i == grid.length-1 || j == grid[0].length-1) {
            if(i == grid.length-1) {
                return grid[i][j] + helper(grid, dp, i, j+1);
            }
            else {
                return grid[i][j] + helper(grid, dp, i+1, j);
            }
        }

        dp[i][j] = Math.min(grid[i][j] + helper(grid, dp, i+1, j), grid[i][j] + helper(grid, dp, i, j+1));

        return dp[i][j];
    }
}
